{
  "name": "osf-web-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/output-check.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "design:check": "node scripts/design-check.mjs && node scripts/design-policy.mjs",
    "design:tokens": "node scripts/design-tokens.mjs",
    "design:tokens:check": "node scripts/design-tokens.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
}
